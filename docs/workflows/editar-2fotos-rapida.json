{
  "amostrador": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "gerar": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "guider": [
        "guia",
        0
      ],
      "latent_image": [
        "latente",
        0
      ],
      "noise": [
        "ruido",
        0
      ],
      "sampler": [
        "amostrador",
        0
      ],
      "sigmas": [
        "passos",
        0
      ]
    }
  },
  "guia": {
    "class_type": "CFGGuider",
    "inputs": {
      "cfg": 1.0,
      "model": [
        "unet",
        0
      ],
      "negative": [
        "ref2_negativo",
        0
      ],
      "positive": [
        "ref2_positivo",
        0
      ]
    }
  },
  "latente": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "batch_size": 1,
      "height": 1024,
      "width": 1024
    }
  },
  "negativo": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "positivo",
        0
      ]
    }
  },
  "passos": {
    "class_type": "Flux2Scheduler",
    "inputs": {
      "height": 1024,
      "steps": 4,
      "width": 1024
    }
  },
  "positivo": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "texto",
        0
      ],
      "text": "PROMPT"
    }
  },
  "ref1_abrir": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "revela/FOTO1.png"
    }
  },
  "ref1_escala": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "ref1_abrir",
        0
      ],
      "megapixels": 1.0,
      "resolution_steps": 1,
      "upscale_method": "nearest-exact"
    }
  },
  "ref1_latente": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "ref1_escala",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "ref1_negativo": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "negativo",
        0
      ],
      "latent": [
        "ref1_latente",
        0
      ]
    }
  },
  "ref1_positivo": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "positivo",
        0
      ],
      "latent": [
        "ref1_latente",
        0
      ]
    }
  },
  "ref2_abrir": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "revela/FOTO2.png"
    }
  },
  "ref2_escala": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "ref2_abrir",
        0
      ],
      "megapixels": 1.0,
      "resolution_steps": 1,
      "upscale_method": "nearest-exact"
    }
  },
  "ref2_latente": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "ref2_escala",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "ref2_negativo": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "ref1_negativo",
        0
      ],
      "latent": [
        "ref2_latente",
        0
      ]
    }
  },
  "ref2_positivo": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "ref1_positivo",
        0
      ],
      "latent": [
        "ref2_latente",
        0
      ]
    }
  },
  "revelar": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "gerar",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "ruido": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    }
  },
  "salvar": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "Revela/REVELA",
      "images": [
        "revelar",
        0
      ]
    }
  },
  "texto": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "device": "default",
      "type": "flux2"
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux-2-klein-4b.safetensors",
      "weight_dtype": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  }
}
