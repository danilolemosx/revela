{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revela",
  "mainBinaryName": "revela",
  "version": "0.1.0",
  "identifier": "com.danilolemos.revela",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Revela",
        "width": 1440,
        "height": 900,
        "minWidth": 1240,
        "minHeight": 780,
        "dragDropEnabled": true,
        "backgroundColor": "#1a1a1a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["/Volumes/**", "/Users/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Video",
    "shortDescription": "Imagens com IA, 100% local",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.3"
    }
  }
}
